# Server Settings
LIVENESS_HOST=127.0.0.1
LIVENESS_PORT=8000
LIVENESS_LOG_LEVEL=INFO
LIVENESS_ENVIRONMENT=development

# CORS Configuration (JSON array or comma-separated list of explicit allowed origins)
LIVENESS_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Persistence & Storage
LIVENESS_DATABASE_URL=sqlite:///./data/liveness.db
LIVENESS_PHOTO_STORAGE_DIR=./storage_data/accepted_photos

# Anti-Spoofing & Face Landmarker Model Configuration
# Relative to backend/ directory or absolute path
LIVENESS_FACE_LANDMARKER_MODEL_PATH=../models/face_landmarker.task
LIVENESS_FACE_LANDMARKER_SHA256=64184e229b263107bc2b804c6625db1341ff2bb731874b0bcc2fe6544e0bc9ff
LIVENESS_PRIMARY_MODEL_PATH=../models/MiniFASNetV2.onnx
LIVENESS_PRIMARY_MODEL_SCALE=2.7
LIVENESS_PRIMARY_MODEL_SHA256=b32929adc2d9c34b9486f8c4c7bc97c1b69bc0ea9befefc380e4faae4e463907
LIVENESS_SECONDARY_MODEL_PATH=../models/MiniFASNetV1SE.onnx
LIVENESS_SECONDARY_MODEL_SCALE=4.0
LIVENESS_SECONDARY_MODEL_SHA256=ebab7f90c7833fbccd46d3a555410e78d969db5438e169b6524be444862b3676
LIVENESS_VERIFY_MODEL_CHECKSUM=true
LIVENESS_ONNX_EXECUTION_PROVIDER=CPUExecutionProvider
LIVENESS_ONNX_INTRA_OP_THREADS=2
LIVENESS_ONNX_INTER_OP_THREADS=1

# Image Quality Thresholds
LIVENESS_MIN_IMAGE_WIDTH=320
LIVENESS_MIN_IMAGE_HEIGHT=240
LIVENESS_MAX_IMAGE_WIDTH=4096
LIVENESS_MAX_IMAGE_HEIGHT=4096
LIVENESS_MIN_BRIGHTNESS=45.0
LIVENESS_MAX_BRIGHTNESS=225.0
LIVENESS_MIN_BLUR_LAPLACIAN_VAR=35.0
LIVENESS_MIN_FACE_AREA_RATIO=0.04
LIVENESS_MAX_FACE_AREA_RATIO=0.75
LIVENESS_MAX_CENTER_OFFSET_RATIO=0.28

# Active Challenge & Timing Thresholds
LIVENESS_SESSION_TTL_SECONDS=180
LIVENESS_CHALLENGE_COUNT=3
LIVENESS_CENTER_YAW_MAX_DEG=12.0
LIVENESS_CENTER_PITCH_MAX_DEG=16.0
LIVENESS_TURN_LEFT_MIN_YAW_DEG=-13.0
LIVENESS_TURN_RIGHT_MIN_YAW_DEG=13.0
LIVENESS_MIN_CHALLENGE_PASSING_FRAMES=2

# Passive Anti-Spoofing Thresholds
LIVENESS_SPOOF_REAL_SCORE_THRESHOLD=0.65
LIVENESS_SPOOF_MIN_FRAME_SCORE=0.45
LIVENESS_PASSIVE_SAMPLE_FRAMES_MAX=5

# Request & Rate Limits
LIVENESS_MAX_REQUEST_BYTES=6291456
LIVENESS_MAX_FRAMES_PER_BATCH=10
LIVENESS_MIN_FRAMES_PER_BATCH=2
LIVENESS_RATE_LIMIT_REQUESTS_PER_MINUTE=60
